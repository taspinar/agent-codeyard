{
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "decision", "rationale", "amendment"],
        "properties": {
          "finding_id": { "type": "string" },
          "decision": {
            "type": "string",
            "enum": ["ADOPT", "REJECT", "DEFER", "ESCALATE", "AMEND"]
          },
          "rationale": { "type": "string" },
          "amendment": {
            "anyOf": [
              { "type": "null" },
              { "type": "string" }
            ]
          }
        }
      }
    }
  }
}
