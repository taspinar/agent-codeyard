---
// What this way of working adds to using Claude Code or Codex directly, in
// three groups (#331). The page opens with that answer; what Codeyard is not
// follows in two sentences. Each feature shows, in plain words, the problem,
// what you get and one example: the illustrative gym scenario of #328, or a
// real record with its link. The note beside the heading says whether the
// feature is on by default or needs configuration. Behind the "How ..."
// disclosure, closed by default, follow what Codeyard does, the mechanism,
// one real artifact (an excerpt of a file of this repository, a published
// review, a pull request or a run record), the files and the docs page with
// the detail: file names, configuration and JSON appear only there. The facts
// follow the scripts and policy files on main; every figure names its Issue,
// pull request or run record.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Section from "../components/Section.astro";
import Table from "../components/Table.astro";
import { href, issue, pull, repoFile } from "../lib/links";

const comment = (number: number, id: string) => `${issue(number)}#issuecomment-${id}`;
const bare = (url: string) => url.replace(/^https:\/\//, "");

const groups = [
  { id: "planning", title: "Before coding starts", features: [
    { id: "requirements", title: "Agree on what to build before coding starts" },
    { id: "architecture", title: "Give every feature the same project plan" },
    { id: "isolation", title: "Keep changes separate while they are being built" },
  ] },
  { id: "quality", title: "Before a change reaches you", features: [
    { id: "evidence", title: "See what was checked against your requirements" },
    { id: "review", title: "Give each change a second review" },
    { id: "risk", title: "Adjust the checks to the kind of change" },
  ] },
  { id: "control", title: "Between your decisions", features: [
    { id: "unattended", title: "Let the workflow run between your decisions" },
    { id: "authority", title: "Decide which changes become part of your project" },
  ] },
];
const feature = Object.fromEntries(groups.flatMap((group) => group.features).map((item) => [item.id, item.title]));
const group = Object.fromEntries(groups.map((item) => [item.id, item.title]));

// The shipped .agents/agents.conf, with the permission profile each role runs under.
const roles = [
  { role: "implementer", agent: "claude opus", access: "writes; unattended in a run" },
  { role: "implementer@high", agent: "claude fable", access: "writes; unattended in a run" },
  { role: "reviewer", agent: "codex gpt-6-luna", access: "read-only" },
  { role: "triage", agent: "claude sonnet", access: "read-only" },
  { role: "triage-implementer", agent: "claude opus", access: "writes; unattended in a run" },
  { role: "triage-implementer@high", agent: "claude fable", access: "writes; unattended in a run" },
];

// Four lines of .agents/records/feature-241.jsonl, the run of PR #249, shortened
// where marked: the fields run, epoch and id are left out.
const record = `{"schema":"run-record/v1",[...]"time":"2026-10-30T19:27:28Z",
 "type":"agent-start","role":"implementer","profile":"unattended",
 "agent":"claude","model":"opus","level":"medium",[...]}
{"schema":"run-record/v1",[...]"time":"2026-10-30T19:37:53Z",
 "type":"verification","status":0,"seconds":14,"reused":false,[...]}
{"schema":"run-record/v1",[...]"time":"2026-10-30T19:38:09Z",
 "type":"completion-gate","check":1,"sessions":1,[...]"status":"complete",[...]}
{"schema":"run-record/v1",[...]"time":"2026-10-30T19:38:12Z",
 "type":"agent-start","role":"reviewer","profile":"read-only",
 "agent":"codex","model":"gpt-6-luna","level":"medium",[...]}`;
// Proposal 5 of the run analysis of 28 October 2026
// (.agents/analysis/20261028T181115Z-6036a8954003/report.md), shortened where
// marked, and its closing line; the proposal became Issue #217.
const analysis = `5. **Keep accepted and deferred findings from being re-raised, and make
   'unresolved' re-raises cite the earlier id**, place: template (an Issue
   in the template repository)
   - Re-raised findings caused extra triage and repair rounds in five runs,
     and in feature 195 the reviewer ignored two ACCEPT decisions although
     the prompt forbids it. A structural check is more reliable than prompt
     wording.
   - follows from: C1, C2, C17
   - enforceable check: check-review.sh: in a review of changes only, a
     finding that names an earlier id with decision ACCEPT or DEFER is
     rejected unless it states that the change made it worse; [...]
[...]
Nothing was changed. A proposal goes through the review and approval that
apply to its place.`;
---
<Base title="Why Codeyard" description="What Agent Codeyard adds to using Claude Code or Codex directly: agree on what to build first, one project plan, changes kept apart, checks against your requirements, a second review, checks that fit the change, runs between your decisions, and the final say over every change.">
  <PageHead title="Why Codeyard" lede="Claude Code and Codex write the code. Codeyard adds the way of working around them: you agree on what to build first, every change is checked against that and read by a second AI, and nothing joins your project until you accept it.">
    <p>Codeyard writes no code itself and is not a hosted service. It runs on your machine or server, and the coding tools send what they work on to their own providers.</p>
    <p>The examples follow the <a href={href("#example")}>illustrative example of the home page</a>: a gym's member application, in which trainers record attendance for their classes and members see their own training history.</p>
    <p class="needs">Who it is for, what it costs and whether it works with an existing repository: the <a href={href("faq/")}>FAQ</a>.</p>
    <ol class="contents grouped">
      {groups.map((group) => (
        <li><a href={`#${group.id}`}>{group.title}</a>
          <ol>{group.features.map((item) => <li><a href={`#${item.id}`}>{item.title}</a></li>)}</ol>
        </li>
      ))}
      <li><a href="#learn">Use past runs to improve the process</a></li>
    </ol>
  </PageHead>

  <section id="planning" class="group" aria-labelledby="planning-h">
    <div class="wrap">
      <h2 id="planning-h">{group.planning}</h2>
      <p class="lede">What to build, how it fits, and where the work happens.</p>
    </div>
  </section>

  <Section id="requirements" title={feature.requirements} level={3}>
    <Fragment slot="note"><strong>Default</strong> for every feature. <a href={href("docs/detailed-workflow/")}>Every step</a> in the docs.</Fragment>
    <dl class="pitch">
      <dt>The problem</dt><dd>An AI tool fills a gap in your description with a guess, and the review then checks the code against the guess, not against what you wanted.</dd>
      <dt>What you get</dt><dd>Questions that change what is built reach you before any code exists. You decide; the tool does not guess.</dd>
      <dt>Illustrative example</dt><dd>Before attendance is built, you are asked whether members may see each other's data. You answer: only their own history. The change is later checked against that.</dd>
    </dl>
    <details class="proof">
      <summary>How the questions work: files, settings and a real record</summary>
      <p><b>What Codeyard does.</b> Once per project, a requirements interview, the Project Grill, writes the requirements down with you. For each feature, the agent that writes the code first decides whether the Issue is clear; when a decision is open, it changes nothing and asks you.</p>
      <figure class="plain">
        <svg class="lines" viewBox="0 0 1100 170" role="img" aria-labelledby="requirements-t" aria-describedby="requirements-words">
          <title id="requirements-t">Requirements before the code: the Project Grill agrees the project's requirements with you once; per feature the implementer reads the Issue and its context and decides whether it is clear. When it needs clarification the run stops, you answer, and it reads again; when it is clear it implements.</title>
          <path class="branch" d="M760 90 L720 50 H560 L520 90"/>
          <rect class="gate-o" x="630" y="40" width="20" height="20" transform="rotate(45 640 50)"/>
          <text class="note" x="640" y="24" text-anchor="middle">needs clarification: the run stops, you answer, it reads again</text>
          <path class="l1" d="M80 90 H290"/>
          <path class="l2" d="M290 90 H1010"/>
          <circle class="dot" cx="80" cy="90" r="10"/><text class="st" x="80" y="127" text-anchor="middle">Project Grill</text><text class="sub k" x="80" y="147" text-anchor="middle">start-planning.sh</text>
          <circle class="dot" cx="290" cy="90" r="10"/><text class="st" x="290" y="127" text-anchor="middle">Requirements</text><text class="sub k" x="290" y="147" text-anchor="middle">PROJECT_REQUIREMENTS.md</text>
          <circle class="dot" cx="520" cy="90" r="10"/><text class="st" x="520" y="127" text-anchor="middle">Read the Issue</text><text class="sub" x="520" y="147" text-anchor="middle">comments, requirements, ADRs</text>
          <circle class="dot" cx="760" cy="90" r="10"/><text class="st" x="760" y="127" text-anchor="middle">Decide</text><text class="sub" x="760" y="147" text-anchor="middle">clear or needs clarification</text>
          <circle class="dot" cx="1010" cy="90" r="10"/><text class="st" x="1010" y="127" text-anchor="middle">Implement</text><text class="sub k" x="1010" y="147" text-anchor="middle">clear</text>
        </svg>
        <ol class="words" id="requirements-words">
          <li><b>Project Grill</b><small class="k">start-planning.sh</small><p class="cond">Questions you about goals, users and scope, once per project.</p></li>
          <li><b>Requirements</b><small class="k">docs/PROJECT_REQUIREMENTS.md</small><p class="cond">An Issue cannot override them silently.</p></li>
          <li><b>Read the Issue</b><small>with your comments, the requirements, the architecture, the ADRs and the code</small></li>
          <li><b>Decide</b><small>clear or needs clarification</small><p class="cond">Needs clarification: nothing changes, the questions go into the handoff note, and the run stops with status 3.</p></li>
          <li class="ask"><b>You answer</b><small>only when asked</small><p class="cond">In the handoff note or on the Issue; the next session reads again.</p></li>
          <li><b>Implement</b><small class="k">Clarification: clear</small></li>
        </ol>
      </figure>
      <div class="split">
        <div><h5>Once per project</h5><ul>
          <li><code>start-planning.sh</code>: the Project Grill questions you about goals, users and scope until the requirements are agreed, and writes <code>docs/PROJECT_REQUIREMENTS.md</code>.</li>
          <li>An Issue cannot override them silently: where it would, the conflict is a question for you, with a proposed ADR or an update of the requirements as one option.</li>
        </ul></div>
        <div><h5>Once per feature</h5><ul>
          <li>The implementer reads the Issue, your comments on it, the requirements, the architecture, the ADRs and the code, and decides: clear, or needs clarification.</li>
          <li>Needs clarification: it changes nothing, writes its questions with options and a recommendation, and the run stops with status 3. You answer in the handoff note or on the Issue.</li>
        </ul></div>
      </div>
      <pre role="region" class="excerpt" aria-label="Excerpt of the implementer contract"><span class="src">.agents/prompts/implementer.md · Clarification, excerpt</span>- **Clear:** implement. Write `**Clarification:** clear` into the handoff
  note, with one line on why, so that the record shows the step was taken.
- **Needs clarification:** change nothing in the repository. Write each
  question under "Open questions" in the handoff note, with the decision it
  settles and, where you can, the options and your recommendation. [...]
  Nothing is reviewed or committed until the owner answers.</pre>
      <p>Names, private helpers and other choices the agent can make itself are not questions for you; it records them in the handoff note. Only comments of the owner, members and collaborators reach the agents. On <a href={issue(16)}>#16</a>, the clarification gate itself, the owner's two comments settled the design and the run took 26 minutes from start to pull request (<a href={pull(213)}>PR #213</a>).</p>
      <dl class="facts">
        <dt>files</dt><dd><a href={repoFile(".agents/prompts/implementer.md")}><code>implementer.md</code></a>, <a href={repoFile(".agents/prompts/project-grill.md")}><code>project-grill.md</code></a></dd>
        <dt>docs</dt><dd><a href={href("docs/detailed-workflow/#clarify-the-requirements-project-grill")}>Clarify the requirements</a>, <a href={href("docs/detailed-workflow/#implement-the-feature")}>Implement the feature</a></dd>
        <dt>built in</dt><dd><a href={pull(22)}>PR #22</a> (planning), <a href={pull(213)}>#213</a> (clarification), <a href={pull(185)}>#185</a> (your comments)</dd>
      </dl>
    </details>
  </Section>

  <Section id="architecture" title={feature.architecture} level={3}>
    <Fragment slot="note"><strong>Default</strong> when you plan with Codeyard. <a href={href("docs/detailed-workflow/")}>Every step</a> in the docs.</Fragment>
    <dl class="pitch">
      <dt>The problem</dt><dd>Features built side by side each make their own design choices, and after a few weeks the code no longer follows one design.</dd>
      <dt>What you get</dt><dd>Every feature starts from one approved plan; changing the plan is a decision you approve, not a side effect.</dd>
      <dt>Illustrative example</dt><dd>The plan builds users and roles first, then attendance, then the history view. Both later features use the same roles instead of inventing their own.</dd>
    </dl>
    <details class="proof">
      <summary>How the plan is reviewed and approved: files, settings and a real record</summary>
      <p><b>What Codeyard does.</b> The architecture, the roadmap and the first ADRs (architecture decision records: short files that each record one design decision) are reviewed by an agent of another AI provider and approved by you before the first feature starts. Every feature session reads them first, and an accepted ADR outranks the Issue.</p>
      <figure class="plain">
        <svg class="lines" viewBox="0 0 1100 160" role="img" aria-labelledby="planning-t" aria-describedby="planning-words">
          <title id="planning-t">The planning line: plan, independent review of the plan, a decision per finding, your approval. A later change goes back through the review and your approval. Then the features start, and every feature session reads the approved documents first.</title>
          <path class="branch" d="M780 80 L740 40 H340 L300 80"/>
          <text class="note" x="540" y="28" text-anchor="middle">a later change: review and approval again</text>
          <path class="l1" d="M90 80 H780"/>
          <path class="l2" d="M780 80 H1040"/>
          <circle class="dot" cx="90" cy="80" r="10"/><text class="st" x="90" y="117" text-anchor="middle">Plan</text><text class="sub k" x="90" y="137" text-anchor="middle">start-planning.sh</text>
          <circle class="dot" cx="300" cy="80" r="10"/><text class="st" x="300" y="117" text-anchor="middle">Plan review</text><text class="sub k" x="300" y="137" text-anchor="middle">review-planning.sh</text>
          <circle class="dot" cx="540" cy="80" r="10"/><text class="st" x="540" y="117" text-anchor="middle">A decision per finding</text><text class="sub k" x="540" y="137" text-anchor="middle">revise-planning.sh</text>
          <rect class="gate" x="770" y="70" width="20" height="20" transform="rotate(45 780 80)"/><text class="st" x="780" y="117" text-anchor="middle">Your approval</text><text class="sub k" x="780" y="137" text-anchor="middle">finish-planning.sh</text>
          <circle class="dot" cx="1040" cy="80" r="10"/><text class="st" x="1040" y="117" text-anchor="middle">Features</text><text class="sub" x="1040" y="137" text-anchor="middle">read it first</text>
        </svg>
      </figure>
      <ol class="words timeline" id="planning-words">
        <li><b>Plan</b><small class="k">start-planning.sh</small><p>The planner writes <code>docs/architecture.md</code>, the first ADRs and <code>docs/roadmap.md</code> from the agreed requirements.</p></li>
        <li><b>Independent review of the plan</b><small class="k">review-planning.sh</small><p>An agent of another provider reviews it, read-only.</p></li>
        <li><b>A decision per finding</b><small class="k">revise-planning.sh</small><p>Every finding of the plan review gets a recorded decision.</p></li>
        <li class="you"><b>Your approval</b><small class="k">finish-planning.sh</small><p>Tied to the version of the documents you approved. A later change goes through review and approval again.</p></li>
        <li><b>Features</b><p>Built in parallel, each session reads the approved architecture, ADRs and roadmap first.</p></li>
      </ol>
      <pre role="region" class="excerpt" aria-label="Excerpt of AGENTS.md"><span class="src">AGENTS.md · Source precedence</span>1. Explicit current human instruction
2. Accepted ADRs
3. Current GitHub issue acceptance criteria
4. AGENTS.md
5. Current architecture documentation
6. Active feature plan
7. Handoff documents
8. Previous agent assumptions

If a material conflict remains, stop and report it.</pre>
      <p>An accepted ADR outranks the Issue, so a feature cannot quietly change the design: an implementer that would have to stops and reports the conflict, a new ADR enters as <code>Proposed</code>, and a pull request that adds, changes or removes an ADR is marked as needing your approval before the merge. The reviewer classifies each feature's impact on the architecture; major or breaking makes the feature high risk and needs you too.</p>
      <dl class="facts">
        <dt>rules</dt><dd><a href={repoFile("AGENTS.md")}><code>AGENTS.md</code></a> and the planning scripts</dd>
        <dt>files</dt><dd><a href={repoFile("docs/architecture.md")}><code>docs/architecture.md</code></a>, <a href={repoFile("docs/decisions/README.md")}><code>docs/decisions/</code></a>, <a href={repoFile("docs/roadmap.md")}><code>docs/roadmap.md</code></a></dd>
        <dt>docs</dt><dd><a href={href("docs/detailed-workflow/#create-the-project-plan")}>Create the project plan</a>, <a href={href("docs/detailed-workflow/#approve-the-plan")}>Approve the plan</a></dd>
        <dt>built in</dt><dd><a href={pull(22)}>PR #22</a> (planning), <a href={pull(100)}>#100</a> (the merge approval gate)</dd>
      </dl>
    </details>
  </Section>

  <Section id="isolation" title={feature.isolation} level={3}>
    <Fragment slot="note"><strong>Default</strong> for every feature. <a href={href("docs/technical-reference/#working-directories")}>Working directories</a> in the docs.</Fragment>
    <dl class="pitch">
      <dt>The problem</dt><dd>Two AI tools writing in the same folder overwrite each other's files.</dd>
      <dt>What you get</dt><dd>Features are built side by side, can stop and continue, and each reaches you as its own change. Separate folders keep files apart, not databases or services.</dd>
      <dt>Illustrative example</dt><dd>Attendance is built in its own folder while your main copy stays untouched. If the session stops halfway, the next one continues from a short progress note.</dd>
    </dl>
    <details class="proof">
      <summary>How a feature gets its own folder: files, settings and a real record</summary>
      <p><b>What Codeyard does.</b> Every feature gets its own branch and its own worktree, a second working folder of the same Git repository, and one agent writes in it. A new session continues from the feature's handoff note, a short file that says what is done and what remains.</p>
      <pre role="region" tabindex="0" class="term" aria-label="Terminal commands"><span class="c"># a branch feature/&lt;issue&gt;-&lt;slug&gt; and a worktree beside the main checkout</span>
<span class="p">$ </span>./scripts/start-feature.sh 241
<span class="c"># a new session continues from the handoff note, not the earlier conversation</span>
<span class="p">$ </span>./scripts/start-feature.sh 241 --resume
<span class="c"># after the merge, from the primary checkout</span>
<span class="p">$ </span>./scripts/cleanup-worktree.sh 241</pre>
      <figure class="plain">
        <svg class="lines" viewBox="0 0 1100 160" role="img" aria-labelledby="isolation-t" aria-describedby="isolation-words">
          <title id="isolation-t">The line of one feature: start creates its branch and worktree; the work happens there, with one writer, and a new session resumes from the handoff note; you merge; cleanup removes the merged worktree and branch.</title>
          <path class="branch" d="M320 80 L360 40 H440 L480 80"/>
          <text class="note" x="400" y="28" text-anchor="middle">a new session: --resume, from the handoff note</text>
          <path class="l2" d="M80 80 H990"/>
          <circle class="dot" cx="80" cy="80" r="10"/><text class="st" x="80" y="117" text-anchor="middle">Start</text><text class="sub k" x="80" y="137" text-anchor="middle">start-feature.sh</text>
          <circle class="dot" cx="400" cy="80" r="10"/><text class="st" x="400" y="117" text-anchor="middle">Work in the worktree</text><text class="sub" x="400" y="137" text-anchor="middle">one writer</text>
          <rect class="gate" x="710" y="70" width="20" height="20" transform="rotate(45 720 80)"/><text class="st" x="720" y="117" text-anchor="middle">Merge</text><text class="sub" x="720" y="137" text-anchor="middle">by you</text>
          <circle class="dot" cx="990" cy="80" r="10"/><text class="st" x="990" y="117" text-anchor="middle">Cleanup</text><text class="sub k" x="990" y="137" text-anchor="middle">cleanup-worktree.sh</text>
        </svg>
        <ol class="words lines-words" id="isolation-words">
          <li><b>Start</b><small class="k">start-feature.sh</small><p class="cond">A branch feature/&lt;issue&gt;-&lt;slug&gt; and a worktree beside the main checkout.</p></li>
          <li><b>Work in the worktree</b><small>one writer</small><p class="cond">A new session continues with --resume, from the handoff note.</p></li>
          <li class="you"><b>Merge</b><small>by you</small></li>
          <li><b>Cleanup</b><small class="k">cleanup-worktree.sh</small><p class="cond">Removes the merged worktree and branch, after it copied their run records.</p></li>
        </ol>
      </figure>
      <ul class="rules">
        <li><b>One writer per worktree.</b> Parallel agents need separate worktrees and branches.</li>
        <li><b>Resumable.</b> The handoff note, <code>.agents/handoffs/&lt;issue&gt;.md</code>, says what is done, in progress, remaining and rejected; the files are the truth, the note the summary.</li>
        <li><b>Prepared.</b> An optional setup script copies ignored files, such as installed dependencies, into a new worktree.</li>
        <li><b>Cleaned up.</b> <code>cleanup-worktree.sh</code> removes merged worktrees and branches, after it copied their run records.</li>
      </ul>
      <p>A worktree separates working files; it is not a sandbox for databases, services or credentials. <a href={pull(249)}>PR #249</a>, for example, came from the branch <code>feature/241-write-the-features-examples</code>.</p>
      <dl class="facts">
        <dt>rules</dt><dd><a href={repoFile("AGENTS.md")}><code>AGENTS.md</code></a></dd>
        <dt>scripts</dt><dd><a href={repoFile("scripts/start-feature.sh")}><code>start-feature.sh</code></a>, <a href={repoFile("scripts/cleanup-worktree.sh")}><code>cleanup-worktree.sh</code></a></dd>
        <dt>built in</dt><dd><a href={pull(57)}>PR #57</a> (cleanup), <a href={pull(71)}>#71</a> (setup script), <a href={pull(77)}>#77</a> (resume)</dd>
      </dl>
    </details>
  </Section>

  <section id="quality" class="group" aria-labelledby="quality-h">
    <div class="wrap">
      <h2 id="quality-h">{group.quality}</h2>
      <p class="lede">What shows a change does what you agreed, and who checked it.</p>
    </div>
  </section>

  <Section id="evidence" title={feature.evidence} level={3}>
    <Fragment slot="note"><strong>Default</strong>; the checks are the ones your project sets up. <a href={href("docs/verification-and-completion/")}>Verification and completion</a> in the docs.</Fragment>
    <dl class="pitch">
      <dt>The problem</dt><dd>An AI tool that says it is done tells you its session ended, not which requirements are met.</dd>
      <dt>What you get</dt><dd>Each change lists every requirement with what shows it is met, and checks that ran on exactly that version. A check proves what it examines, no more.</dd>
      <dt>Illustrative example</dt><dd>The attendance change lists “a member sees only their own history: met”, with the check that refuses a request for another member's history.</dd>
    </dl>
    <details class="proof">
      <summary>How the evidence is recorded: files, settings and a real record</summary>
      <p><b>What Codeyard does.</b> The agent writes a completion record: for each criterion, met or not, and what shows it. One command runs every check of the project and records the content they passed for by its fingerprint, a short code computed from the files; unfinished work goes back to the agent before anything is reviewed.</p>
      <figure class="plain">
        <svg class="lines" viewBox="0 0 1100 170" role="img" aria-labelledby="evidence-t" aria-describedby="evidence-words">
          <title id="evidence-t">Evidence before review: the implementer writes the completion record, verify.sh records a pass for the content, and the completion gate reads the record. Partial starts the implementer again; blocked stops the run until you answer; complete or awaiting_evidence goes on to the review.</title>
          <path class="branch" d="M680 90 L640 50 H120 L80 90"/>
          <text class="note" x="380" y="38" text-anchor="middle">partial: the implementer is started again</text>
          <path class="branch" d="M680 90 L720 50 H800"/>
          <rect class="gate-o" x="804" y="40" width="20" height="20" transform="rotate(45 814 50)"/>
          <text class="note" x="814" y="24" text-anchor="middle">blocked: the run stops, you answer</text>
          <path class="l2" d="M80 90 H1010"/>
          <circle class="dot" cx="80" cy="90" r="10"/><text class="st" x="80" y="127" text-anchor="middle">Implement</text><text class="sub k" x="80" y="147" text-anchor="middle">completion/&lt;n&gt;.json</text>
          <circle class="dot" cx="360" cy="90" r="10"/><text class="st" x="360" y="127" text-anchor="middle">Verify</text><text class="sub k" x="360" y="147" text-anchor="middle">verify.sh</text>
