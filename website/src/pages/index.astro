---
// The home page, in the six sections of the owner's brief of 11 November
// (#370): the promise, the interactive workflow, what Codeyard adds to the
// coding tools, a real run as evidence, who it is for, and the two ways to
// start. The demo is illustrative; the evidence is the real case of #241 as
// Engineering records tells it. The old anchors of the page point to the
// section that took their content: #example and #roles to the demo, #projects
// to the evidence; #why, #who and #start keep their names.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import WorkflowDemo from "../components/WorkflowDemo.astro";
import { site } from "../../site.config";
import { href, issue, pull } from "../lib/links";

const [first, ...rest] = site.tagline.split(/(?<=\.) /);
const second = rest.join(" ");

// What can happen when a coding tool works on its own, and what Codeyard
// settles instead, row by row.
const compare = [
  { topic: "Requirements", without: "Agents may fill in missing requirements.", with: "Important decisions are settled before coding." },
  { topic: "Context", without: "Work can lose context between sessions.", with: "Plans, decisions and handoffs persist." },
  { topic: "Review", without: "Reviews may lack independent scrutiny.", with: `A separate model <a href="${href("features/#review")}">reviews the changes</a> by default.` },
  { topic: "Completion", without: "Completion can be difficult to verify.", with: "Checks, evidence and approval gates control what advances." },
];

// The comment on Issue #241 with the review and triage of round 1.
const review = `${issue(241)}#issuecomment-6531925164`;
---
<Base description={site.description}>
  <div class="hero wrap">
    <div class="hero-grid">
      <h1>{first} <em>{second}</em></h1>
      <div class="hero-side">
        <p class="lede">{site.description}</p>
        <div class="actions">
          <a class="btn" href="#demo">Watch it work</a>
          <a href={href("docs/getting-started/")}>Get started</a>
        </div>
      </div>
    </div>
    <p class="facts-line"><span>Open source</span><span>Runs on your machine</span><span>Works with Claude Code and Codex</span><span>You control every merge</span></p>
  </div>

  <section id="demo" class="demo-section" aria-labelledby="demo-h">
    <span id="example"></span><span id="example-h"></span><span id="roles"></span><span id="roles-h"></span>
    <div class="wrap">
      <div class="demo-head">
        <h2 id="demo-h">See how Agent Codeyard works</h2>
        <div>
          <p class="demo-lead">Follow an illustrative project from the first idea to three independently reviewed pull requests.</p>
          <p><strong>Illustrative demo, not a live run.</strong> The gym project, the messages, the files and the Issue and pull request numbers are simulated; the steps and the script names are those of the workflow.</p>
        </div>
      </div>
      <WorkflowDemo />
    </div>
  </section>

  <Section id="why" title="Why not just use Claude Code or Codex?">
    <p>AI coding tools can already plan, implement, test and review code. Agent Codeyard makes these activities part of a repeatable, documented engineering process.</p>
    <div class="compare rows" role="group" aria-label="What can happen with a coding tool alone, and what Agent Codeyard does" style={`--rows: ${compare.length + 1}`}>
      <div class="col"><h3>What can happen</h3><dl>
        {compare.map((row) => <div><dt>{row.topic}</dt><dd>{row.without}</dd></div>)}
      </dl></div>
      <div class="col"><h3>With Agent Codeyard</h3><dl>
        {compare.map((row) => <div><dt>{row.topic}</dt><dd set:html={row.with} /></div>)}
      </dl></div>
    </div>
    <p><a href={href("features/")}>Explore all features</a></p>
  </Section>

  <Section id="evidence" title="Built with the process it describes.">
    <span id="projects"></span>
    <p>See a real Agent Codeyard run, from a GitHub issue to an independently reviewed pull request, including verification evidence and resolved findings.</p>
    <p>Unlike the simulated demo above, this is a real run of this project, on 30 October 2026.</p>
    <ol class="evidence" aria-label="The run of Issue 241, from the Issue to the pull request">
      <li><b><a href={issue(241)}>Issue #241</a></b><span>Asked for the first Features, Examples and About pages of this site.</span></li>
      <li><b>Review and checks</b><span>The checks passed twice, in 14 and 15 seconds. <a href={review}>Round 1 of the review</a> found one major problem, fixed in the same run; round 3 passed.</span></li>
      <li class="you"><b><a href={pull(249)}>Pull request #249</a></b><span>Merged by the owner the same evening.</span></li>
    </ol>
    <p><a href={href("docs/engineering-records/#story")}>The full case in Engineering records</a></p>
  </Section>

  <Section id="who" title="Built for developers who want more control over AI-generated software.">
    <p>For developers and technical teams who use AI coding tools on new or existing projects, especially when the requirements, the verification and an independent review matter, or when several features and long-running work have to stay on track.</p>
    <p>You need Git and a GitHub repository, a command line, and access to the supported AI coding tools. Agent Codeyard is open source; the model providers may cost money. It is not a no-code app builder and not a hosted service. <a href={href("faq/#who")}>Who it is for, in the FAQ</a></p>
  </Section>

  <Section id="start" title="Give your coding agents a process.">
    <p>Start with a new project, or bring Agent Codeyard into an existing repository.</p>
    <div class="split">
      <div><h3>New project</h3><p>Start with requirements and planning before the first feature.</p><p><a href={href("docs/getting-started/")}>Getting started</a></p></div>
      <div><h3>Existing repository</h3><p>Assess your codebase and adopt the workflow incrementally.</p><p><a href={href("docs/adopting/")}>Adoption guide</a></p></div>
    </div>
    <p class="quiet">The source is on <a href={site.repository}>GitHub</a>.</p>
  </Section>
</Base>
