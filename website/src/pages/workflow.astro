---
// A retired route (#377): a redirect page, whose old anchors lead where the
// table of src/lib/redirects.ts says (website/design/INFORMATION-ARCHITECTURE.md, 3.3).
import Redirect from "../layouts/Redirect.astro";
import { moved, routes } from "../lib/redirects";

const route = routes.find((r) => r.path === "workflow/")!;
---
<Redirect title={route.title!} to={moved(route)} label={route.label!} anchors={route.anchors!} />
