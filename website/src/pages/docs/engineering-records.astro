// The other high-risk features of the audit's candidate list, from their run records and pull requests.
const features = [
  { issue: 189, pull: 194, anchor: "owner", problem: "Every feature went through the same workflow, whatever it changed", change: "Compute the risk level of a feature from one policy", rounds: "3", findings: "none", verify: "556, 575, 572", run: "four runs; the implementer resumed by hand" },
  { issue: 193, pull: 199, anchor: "repair", problem: "A missed performance target sent the implementer to repair it, with no diagnosed problem", change: "Treat performance budgets as measurements", rounds: "4", findings: "1 major, re-raised once; 1 minor; all fixed", verify: "761, 762, 761", run: "1 h 18 min" },
