  { round: 4, kind: "the fixes", verdict: "no findings", finding: "–", decision: "–" },
  { round: 5, kind: "complete feature", verdict: "PASS WITH MINOR FINDINGS", finding: "MIN1, minor: the review schema makes previous required", decision: "ACCEPT", link: comment(217, "6483051924") },
