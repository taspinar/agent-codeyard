---
// The Projects page (#332, step 4 of #328), at the route /examples/: two
// products of the maker in the seven parts of a product case (ProductCase).
// FightAnalytics, the gym platform the illustrative example of #328 is
// modelled on, whose repository and records are private, so it shows the
// public website and the labelled example only (the owner's decisions 1 to 3
// on #328); and Physics by Construction, a course that runs this workflow,
// with #388 from the records it published on GitHub. The engineering case
// studies of this repository moved to /docs/engineering-records/ (#344); each
// of their ids stays here as one line that points to the same id there, shown
// when a visitor lands on it. Every figure comes from a source named beside
// it: the Issue and its published comments, or the pull request and its
// timestamps.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Section from "../components/Section.astro";
import Table from "../components/Table.astro";
import Figure from "../components/Figure.astro";
import CaseSummary from "../components/CaseSummary.astro";
import ProductCase from "../components/ProductCase.astro";
import { href } from "../lib/links";

// Physics by Construction, the repository of the application case.
const pbc = "https://github.com/taspinar/physics-by-construction";
const pbcIssue = (number: number) => `${pbc}/issues/${number}`;
const pbcPull = (number: number) => `${pbc}/pull/${number}`;
const pbcComment = (id: string) => `${pbcIssue(388)}#issuecomment-${id}`;

// The review rounds of PBC #388: the comments on the Issue and the review line of PR #390.
const pbcRounds = [
  { round: 1, verdict: "CHANGES REQUIRED", finding: "M1, major: Criterion 1: whole-site claim equivalence is not evidenced. M2, major: Criterion 6: Issue #364 closure is marked met before its gate", decision: "FIX_NOW, FIX_NOW", link: pbcComment("6682316644") },
  { round: 2, verdict: "CHANGES REQUIRED", finding: "M1, major: The added skips trigger Level 3 and are missing from the risk record", decision: "FIX_NOW", link: pbcComment("6683018872") },
  { round: 3, verdict: "–", finding: "no comment on the Issue", decision: "–" },
  { round: 4, verdict: "PASS", finding: "–", decision: "–" },
];


// The groups of the page and their parts, for the contents list.
const groups = [
  { id: "products", title: "Products", items: [
    { id: "fightanalytics", title: "FightAnalytics, a platform for gyms" },
    { id: "application", title: "Physics by Construction, a physics course" },
  ] },
  { id: "figures", title: "About the figures", items: [
    { id: "absent", title: "What is not shown" },
    { id: "sources", title: "Where the figures come from" },
  ] },
];

// The engineering case studies that moved to the docs (#344): their old ids.
const moved = ["memory", "story", "tradeoff", "features", "owner", "repair", "short", "analysis", "levels"];
---
<Base title="Projects" description="What working with Agent Codeyard looks like in two products of its maker, a gym platform and a physics course, each with what was settled, checked, found and decided.">
  <PageHead title="Projects" lede="Two products by the maker of Agent Codeyard, and what working with it looks like in each. FightAnalytics, a platform for gyms, is shown with an illustrative example modelled on it. Physics by Construction, a physics course, is shown with a real change and its public records.">
    <ol class="contents grouped">
      {groups.map((group) => (
        <li><a href={`#${group.id}`}>{group.title}</a>
          <ol>{group.items.map((item) => <li><a href={`#${item.id}`}>{item.title}</a></li>)}</ol>
        </li>
      ))}
    </ol>
  </PageHead>

  <section id="products" class="group" aria-labelledby="products-h">
    <div class="wrap">
      <h2 id="products-h">Products</h2>
      <p class="lede">What each product is and who uses it, then one change in seven parts: the problem, the change, what was settled first, the agreed check, what the review found, the owner's decision, and the sources.</p>
    </div>
  </section>

  <Section id="fightanalytics" title="FightAnalytics, a platform for gyms" level={3}>
    <Fragment slot="note"><a href="https://fightanalytics.nl">fightanalytics.nl</a>, the maker's own product. Its repository is private.</Fragment>
    <p class="lede">FightAnalytics is a platform for martial-arts gyms, made by Ahmet Taspinar, who also makes Codeyard. Gym owners, trainers and members use it.</p>
    <dl class="facts">
      <dt>gym owners</dt><dd>Manage locations, groups, trainers, users and their roles, with reports per gym and per group.</dd>
      <dt>trainers</dt><dd>Record attendance by scanning a member's barcode, write performance reports, and give members feedback.</dd>
      <dt>members</dt><dd>Check in at a class with their barcode, follow their goals and progress over time in charts, and read their trainer's reports.</dd>
    </dl>
    <Figure>
      <img src={href("images/fightanalytics-dashboard.png")} width="1600" height="1000" loading="lazy" alt="A member's progress page, in Dutch. Left, a gauge with an overall score of 8.2 out of 10, marked as above the group average and 0.9 higher than 90 days before. Right, a radar chart of nine skills, such as technique, condition and strength, in December 2025 against the start in March 2025. Below, the strongest area, the point to improve and the latest personal record." />
      <Fragment slot="caption">The dashboard image that FightAnalytics publishes on its home page, <a href="https://fightanalytics.nl">fightanalytics.nl</a>, as published on 9 November 2026. The functions above are those its website names.</Fragment>
    </Figure>
    <p><strong>Illustrative example.</strong> The gym example of this site is modelled on FightAnalytics. Its questions, check and review finding are made up to show the steps; it does not say how FightAnalytics was built.</p>
    <ProductCase>
      <Fragment slot="problem">Trainers want to record attendance for their classes. Members want to see their own training history.</Fragment>
      <Fragment slot="change">One function: trainers record attendance for their classes; members see their own training history. Planned in order: users and roles, then classes and attendance, then the member's history view.</Fragment>
      <Fragment slot="settled">May members see other members' data? Agreed: no, a member sees only their own history. Also agreed: trainers record and correct attendance for their own classes, and a correction keeps the original entry visible as corrected.</Fragment>
      <Fragment slot="check">A member who requests another member's history is refused; the check runs with the feature.</Fragment>
      <Fragment slot="found">The first version let every signed-in user open the history view. The reviewer reported it, and the fix was checked.</Fragment>
      <Fragment slot="result">A proposed change, with the checks that ran and the review's remarks. The owner decides whether it becomes part of the application.</Fragment>
      <Fragment slot="sources">None: this part is an illustration. The records of FightAnalytics are private, so this page shows none of them.</Fragment>
    </ProductCase>
    <p class="needs">Every step of the example: <a href={href("workflow/")}>How it works</a>.</p>
  </Section>

  <Section id="application" title="Physics by Construction, a physics course" level={3}>
    <Fragment slot="note"><a href={pbc}>Physics by Construction</a> on GitHub, the maker's own course. The change: <a href={pbcIssue(388)}>Issue #388</a>, <a href={pbcPull(390)}>PR #390</a>, 6 November 2026.</Fragment>
    <p class="lede">Physics by Construction is a free website for people who learn physics. Each lesson turns a model into a short program you can run, and tests it against theory, measurements or a proof that a computer checks.</p>
    <p>It is made by Ahmet Taspinar, and its development runs the Codeyard workflow. A lesson whose code fails cannot be published, so the site's checks run on every change. This case is one maintenance change to those checks.</p>
    <Figure>
      <img src={href("images/physics-by-construction-home.png")} width="1280" height="800" loading="lazy" alt="The home page of Physics by Construction: a headline about exploring physics with computation and AI, a Start learning button, and a map of its subjects, from classical mechanics to quantum physics and scientific agents." />
      <Fragment slot="caption">The home page of Physics by Construction, <a href="https://taspinar.github.io/physics-by-construction/">taspinar.github.io/physics-by-construction</a>, screenshot of 9 November 2026.</Fragment>
    </Figure>
    <ProductCase>
      <Fragment slot="problem">The checks that keep every lesson correct crashed now and then, and stopped work that had nothing to do with them. After the change they read the lessons without the step that crashed, and faster.</Fragment>
      <Fragment slot="change">Made with Codeyard: the checks read the lessons with a more direct program, and only when a test needs them. No lesson changed.</Fragment>
      <Fragment slot="settled">Should the two fixes be one change? The owner decided: one request and one proposed change, with a small earlier fix taken along.</Fragment>
      <Fragment slot="check">Six agreed conditions. The first: reading all lessons gives exactly the same results as before, without the step that crashed.</Fragment>
      <Fragment slot="found">A new test could skip itself when something was missing, and so pass without checking anything. It was fixed: the test now checks what it needs. Under the project's own rules the finding raised the change to its highest risk level.</Fragment>
      <Fragment slot="result">At that level the change needed the owner's approval. The owner accepted it the same day.</Fragment>
      <Fragment slot="sources">The request, the four review rounds, the annotated proposed change and the measured times, in the records below.</Fragment>
    </ProductCase>
    <details class="proof">
      <summary>Records: the request, the review rounds, the pull request and the run</summary>
      <CaseSummary>
        <Fragment slot="changed">Reading the claims of the course's lessons starts the pandoc that ships with Quarto directly, instead of one <code>quarto pandoc</code> per lesson block, and the tests read the claims when they run, not when they are loaded.</Fragment>
        <Fragment slot="rounds">4. Rounds 1 and 2 each raised major findings, all fixed; round 4 passed.</Fragment>
        <Fragment slot="found">That the new test of all lessons could skip itself, which under the project's own rules raises the risk level of the change. The level went from 2 to 3, and the merge needed the owner's approval.</Fragment>
        <Fragment slot="result"><a href={pbcPull(390)}>PR #390</a>, opened at 14:09 UTC and merged by the owner at 15:38 UTC. Its description, written at the opening, records the full CI run as pending; that run passed at 15:35, before the merge.</Fragment>
      </CaseSummary>
      <dl class="facts">
        <dt>active run time</dt><dd>Not shown: it is in the run record, which stays on the owner's machine.</dd>
        <dt>waiting time</dt><dd>At least 1 h 29 min: the pull request was open that long before the owner merged it. How long the request waited before the run started is not in the public records.</dd>
        <dt>total lead time</dt><dd>9 h 20 min, from the opening of the Issue, 06:18 UTC, to the merge, 15:38 UTC. Source: the timestamps of <a href={pbcIssue(388)}>the Issue</a> and <a href={pbcPull(390)}>the pull request</a> on GitHub.</dd>
        <dt>tokens, interventions</dt><dd>Not shown. The tokens the models read and the owner's recorded interventions are in the project's run record, which stays on the owner's machine (<a href="#sources">sources</a>).</dd>
      </dl>
      <h4>The request</h4>
      <p>The work started from <a href={pbcIssue(388)}>Issue #388</a>: the GitHub Issue, the ticket that says what to build and how to tell it is done. It names the cause: “Reading the claims of the lessons […] starts one <code>quarto pandoc</code> per lesson block, 183 processes for 94 lessons.” Each call first started Quarto's JavaScript runtime, which took 0.3 s and crashed now and then; according to the Issue the crash stopped the pipelines of another feature four times. The owner asked for both changes, reading the claims on first use and starting pandoc directly, in one Issue and one pull request, and let a small deferred fix ride along (<a href={pbcIssue(364)}>#364</a>).</p>
      <p>The Issue has six acceptance criteria, the conditions the result must meet. The first reads “Reading the claims of all lessons returns the same claims as before (344 at 94 lessons) without starting <code>quarto</code>, and takes under 20 s on the developer machine (measured, not a budget of a test).”</p>

      <h4>The result</h4>
      <p>The description of the pull request, the proposed change on GitHub that the owner reads and merges, states the result as the project measured it: the bundled pandoc “gives the same 344 claims in 9 s instead of 56 s”, and “collecting tests/e2e takes 4 s instead of 65 s and the six selection tests 29 s instead of about five minutes.”</p>
      <p class="needs">These are the project's own measurements on its developer machine, quoted from the pull request. They say what the change did to that project's tests, not how fast Codeyard is.</p>

      <h4>What the review found</h4>
      <p>The implementer is the coding agent that writes the change. The reviewer is a second agent from another provider, here Codex, which can read the change but not edit it. A third agent, the triage, decides what happens to each finding; a major finding must be fixed before the change goes in, unless the owner records <a href={href("docs/detailed-workflow/#owner-exception")}>an exception</a> for it.</p>
      <Table>
        <caption>From the review and triage comments on the Issue, which the workflow publishes for each round with findings, and the review line of the pull request.</caption>
        <thead><tr><th scope="col" class="num">round</th><th scope="col">verdict</th><th scope="col">findings</th><th scope="col">decision</th></tr></thead>
        <tbody>
          {pbcRounds.map((row) => (
            <tr>
              <th scope="row" class="num">{row.link ? <a href={row.link}>{row.round}</a> : row.round}</th>
              <td data-col="verdict" class:list={["k", { off: row.verdict === "–" }]}>{row.verdict}</td>
              <td data-col="findings" class:list={{ off: row.finding === "–" || row.round === 3 }}>{row.finding}</td>
              <td data-col="decision" class:list={["k", { off: row.decision === "–" }]}>{row.decision}</td>
            </tr>
          ))}
        </tbody>
      </Table>
      <p>Round 1 found that the evidence for the first criterion covered one sample page, not all lessons, and that the completion record, the implementer's account of what is done, claimed the closing of #364 before it could happen. The fixes added a test that compares the claims of every lesson both ways. Round 2 found the catch in that test:</p>
      <pre role="region" tabindex="0" class="excerpt" aria-label="Excerpt of the review of round 2 of Physics by Construction Issue 388"><span class="src">{pbcIssue(388).replace(/^https:\/\//, "")} · round 2 · review, excerpt</span>### M1. The added skips trigger Level 3 and are missing from the risk record

**Evidence:** `tests/unit/test_evidence.py::test_the_whole_site_gives_the_same_claims_through_both_ways`
adds `pytest.skip` when lesson sources or a bundled pandoc are unavailable.
The supplied risk record says Level 2 and lists no triggers; ADR 020
decision 1 classifies a new skip as an escalation trigger.</pre>
      <p>A test that skips itself where something is missing can pass without checking anything. The risk level, which the scripts compute from the files a change touches and from triggers such as this one, decides among other things whether the merge needs the owner's approval. The project's own risk policy, which names levels 1 to 3 in a decision record of that project, treats a new skip as a reason for the highest level. The fix removed the skips, and the test now asserts what it needs; the level stayed at 3, as the pull request records.</p>

      <h4>What ran unattended, and where the owner decided</h4>
      <ul class="rules">
        <li><b>Unattended.</b> The triage of rounds 1 and 2, and so the decision to fix: each published triage says “by an unattended run; no human approved these decisions”.</li>
        <li><b>The owner: the scope.</b> The Issue records the owner's word: combine the two changes in one Issue and one pull request, “create the Issue, do not start it yet”, and take #364 along.</li>
        <li><b>The owner: the merge.</b> At level 3 the pull request said “Merge approval: required from the project owner, for exactly this commit”. The owner merged it at 15:38 UTC; #364 closed with it.</li>
      </ul>

      <h4>The pull request, annotated</h4>
      <div class="artifact">
        <pre role="region" tabindex="0" class="record" aria-label="Excerpt of the description of pull request 390 of Physics by Construction"><span class="src">{pbcPull(390).replace(/^https:\/\//, "")} · excerpt</span><span class="pin" aria-hidden="true">1</span><mark>Completion: partial</mark>
- met: Reading the claims of all lessons returns
  the same claims as before without starting
  quarto, in under 20 s on the developer machine […]
- pending (pr_ci): The evidence map tests, the
  lesson-source tests and the selection tests
  pass; the CI full run passes […]

<span class="pin" aria-hidden="true">2</span><mark>Verification:</mark>
- ./scripts/verify.sh passed

<span class="pin" aria-hidden="true">3</span><mark>Review: round 4, PASS, by codex (gpt-6-luna)</mark>;
triage published on #388

<span class="pin" aria-hidden="true">4</span><mark>Merge approval:</mark>
- required from the project owner, for exactly
  this commit
[…]
- the risk level is 3, by the triggers (ADR 020
  decision 1)

<span class="pin" aria-hidden="true">5</span><mark>Risk level:</mark>
- required: level 3, by the triggers
- path minimum: level 2
- escalation trigger: named in the completion
  record: skip or expected failure added (review
  02 M1: […] removed, the test now asserts its
  prerequisites)</pre>
        <ol class="notes">
          <li><span class="pin" aria-hidden="true">1</span><div><b>Completion record</b><span>The implementer's claim, criterion by criterion, with evidence. “Partial” here means waiting, not unfinished: two criteria could only be shown after publishing, the CI run of the pull request and the closing of #364.</span></div></li>
          <li><span class="pin" aria-hidden="true">2</span><div><b>Verification</b><span>The project's full set of checks, recorded for exactly this content.</span></div></li>
          <li><span class="pin" aria-hidden="true">3</span><div><b>Independent review</b><span>Another provider, read-only. The fourth round passed; the triage of the rounds with findings is on the Issue.</span></div></li>
          <li><span class="pin" aria-hidden="true">4</span><div><b>The owner's approval</b><span>Bound to one commit. No script merged it.</span></div></li>
          <li><span class="pin" aria-hidden="true">5</span><div><b>Risk level</b><span>Raised from the minimum of the changed paths by the finding of round 2, and not lowered after the fix.</span></div></li>
        </ol>
      </div>

      <h4>The run</h4>
      <ol class="words timeline" aria-label="The run of Physics by Construction Issue 388, 6 November 2026">
        <li><b>Issue opened</b><small class="k">06:18 UTC</small><p>On the owner's instruction, with six acceptance criteria.</p></li>
        <li><b>Round 1 and triage</b><small class="k">10:05</small><p>Two major findings, fix now.</p></li>
        <li><b>Round 2 and triage</b><small class="k">10:45</small><p>One major finding, fix now; the level becomes 3.</p></li>
        <li><b>Rounds 3 and 4</b><small class="k">between 10:45 and 14:09</small><p>No comment on the Issue; round 4 passed.</p></li>
        <li><b>Pull request</b><small class="k">14:09</small><p>With the completion record, the verification, the review line, the risk level and the merge approval.</p></li>
        <li class="you"><b>Merge by the owner</b><small class="k">15:38 UTC</small><p>The CI run of the pull request had passed at 15:35; the description still shows that criterion as pending, because it was written at the opening. The Issue stays open until its pending criteria are recorded, as the pull request says.</p></li>
      </ol>
    </details>
  </Section>

  <section id="figures" class="group" aria-labelledby="figures-h">
    <div class="wrap">
      <h2 id="figures-h">About the figures</h2>
      <p class="lede">What this page leaves out, and where each figure comes from.</p>
    </div>
  </section>

  <Section id="absent" title="What is not shown" level={3}>
    <ul class="rules">
      <li><b>The records of FightAnalytics.</b> Its repository is private, so this page shows no run, review, figure or pull request of it, and no claim about which of its functions were built with Codeyard.</li>
      <li><b>The run record of Physics by Construction.</b> Its run records stay on the owner's machine, so its case shows no tokens, interventions, verification times or active run time; it shows what the project published on GitHub.</li>
    </ul>
  </Section>

  <Section id="sources" title="Where the figures come from" level={3}>
    <p>The case of Physics by Construction has two sources:</p>
    <Table>
      <thead><tr><th scope="col">source</th><th scope="col">what it holds</th><th scope="col">where</th></tr></thead>
      <tbody>
        <tr><th scope="row">Issue comments</th><td data-col="what it holds">The review report and the triage of every round with findings, published by <code>triage-review.sh</code>; with the Issue itself, its acceptance criteria, the owner's word and the time it was opened</td><td data-col="where">GitHub, on <a href={pbcIssue(388)}>its Issue #388</a></td></tr>
        <tr><th scope="row">Pull request</th><td data-col="what it holds">Completion record, verification, review line, risk level and merge approval, written by <code>finish-feature.sh</code> and <code>publish-feature.sh</code>; the measured result in its summary; when it was opened and merged, and the result of its checks</td><td data-col="where">GitHub, <a href={pbcPull(390)}>PR #390</a></td></tr>
      </tbody>
    </Table>
    <p>Times are given in two parts, where the sources have them:</p>
    <dl class="facts">
      <dt>waiting time</dt><dd>The time before the run started, while the request waited, and after the pull request opened, until the owner merged it.</dd>
      <dt>total lead time</dt><dd>From the opening of the Issue to the merge of its pull request, both timestamps on GitHub.</dd>
    </dl>
    <p>Its run record stays on the owner's machine, so the figures that only a run record gives, tokens, verification seconds, interventions and the active run time, are left out for it.</p>
  </Section>

  <div class="wrap">
    <p class="needs">The engineering case studies, the records of Codeyard's own features, are in the docs: <a href={href("docs/engineering-records/")}>Engineering records</a>.</p>
    <p id="engineering" class="moved-case">The engineering case studies moved to <a href={href("docs/engineering-records/")}>Engineering records</a>.</p>
    {moved.map((id) => <p id={id} class="moved-case">This case moved to <a href={href(`docs/engineering-records/#${id}`)}>Engineering records</a>.</p>)}
  </div>
</Base>
