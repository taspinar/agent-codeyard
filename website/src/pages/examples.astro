// The Projects page (#332, step 4 of #328), at the route /examples/. It opens
// with two products of the maker in the seven parts of a product case
// (ProductCase): FightAnalytics, the gym platform the illustrative example of
// #328 is modelled on, whose repository and records are private, so it shows
// the public website and the labelled example only (the owner's decisions 1
// to 3 on #328); and Physics by Construction, a course that runs this
// workflow, with #388 from the records it published on GitHub. The second
// layer is the engineering case studies of this repository: each a title
// that names the problem, a summary of at most 80 words, and its records
// under a closed "proof" disclosure, so that the first layer stays short and
// every anchor keeps resolving. The high-risk candidates are those of the
// audit on #235. Every figure comes from a source named beside it: the Issue
// and its published review and triage comments, the pull request description
// that finish-feature.sh and publish-feature.sh wrote, its timestamps, or the
// run record of the feature (.agents/records/feature-<n>.jsonl on the
// maintainer's machine, not in the repository; report-runs.sh reads it).
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Section from "../components/Section.astro";
import Table from "../components/Table.astro";
import Figure from "../components/Figure.astro";
import CaseSummary from "../components/CaseSummary.astro";
import ProductCase from "../components/ProductCase.astro";
import { href, issue, pull, repoFile } from "../lib/links";

const comment = (number: number, id: string) => `${issue(number)}#issuecomment-${id}`;

// Physics by Construction, the repository of the application case.
const pbc = "https://github.com/taspinar/physics-by-construction";
const pbcIssue = (number: number) => `${pbc}/issues/${number}`;
const pbcPull = (number: number) => `${pbc}/pull/${number}`;
const pbcComment = (id: string) => `${pbcIssue(388)}#issuecomment-${id}`;

// The review rounds of PBC #388: the comments on the Issue and the review line of PR #390.
const pbcRounds = [
  { round: 1, verdict: "CHANGES REQUIRED", finding: "M1, major: Criterion 1: whole-site claim equivalence is not evidenced. M2, major: Criterion 6: Issue #364 closure is marked met before its gate", decision: "FIX_NOW, FIX_NOW", link: pbcComment("6682316644") },
  { round: 2, verdict: "CHANGES REQUIRED", finding: "M1, major: The added skips trigger Level 3 and are missing from the risk record", decision: "FIX_NOW", link: pbcComment("6683018872") },
  { round: 3, verdict: "–", finding: "no comment on the Issue", decision: "–" },
  { round: 4, verdict: "PASS", finding: "–", decision: "–" },
];

// The review rounds of #241: the run record, the comment on the Issue and the description of PR #249.
const storyRounds = [
  { round: 1, kind: "complete feature", verdict: "CHANGES REQUIRED", finding: "M1, major: examples do not link each candidate to its source files", decision: "FIX_NOW", link: comment(241, "6531925164") },
  { round: 2, kind: "the fixes", verdict: "no findings", finding: "–", decision: "–" },
  { round: 3, kind: "complete feature", verdict: "PASS", finding: "–", decision: "–" },
];

// What the review rounds cost, from the run records: time from the start of
// round 1 to the end of the last review or triage, and the input tokens
// (cached reads included, as the providers report them) of every reviewer,
// triage and fix call.
const costs = [
  { issue: 204, anchor: "short", rounds: "1", found: "nothing", time: "23 s", run: "38 min", tokens: "about 90,000" },
  { issue: 241, anchor: "story", rounds: "3", found: "1 major, fixed", time: "2 min 33 s", run: "13 min", tokens: "about 540,000" },
  { issue: 217, anchor: "memory", rounds: "5", found: "2 majors fixed, 1 minor accepted", time: "46 min", run: "1 h 30 min", tokens: "about 1.1 million" },
];

// The proposals of the run analysis of 28 October 2026 that became Issues.
const proposals = [
  { issue: 216, change: "Record the step and the reason of every stop", pull: 223 },
  { issue: 217, change: "Give every later review round the earlier decisions", pull: 222 },
  { issue: 218, change: "Stop a false partial completion in the handoff note", pull: 221 },
  { issue: 219, change: "Time every check and budget the self-test suite", pull: 224 },
  { issue: 220, change: "Warn about calls of models that agents.conf does not declare", pull: 225 },
];

// The review rounds of #217: the run record and the comments on the Issue.
const rounds = [
  { round: 1, kind: "complete feature", verdict: "CHANGES REQUIRED", finding: "M1, major: earlier approved decisions can disappear when a newer triage is invalid", decision: "FIX_NOW", link: comment(217, "6482184594") },
  { round: 2, kind: "the fixes", verdict: "no findings", finding: "–", decision: "–" },
  { round: 3, kind: "complete feature", verdict: "CHANGES REQUIRED", finding: "M1, major: predecessor validation allows re-raises to weaken a FIX_NOW gate", decision: "FIX_NOW", link: comment(217, "6482598113") },
  { round: 4, kind: "the fixes", verdict: "no findings", finding: "–", decision: "–" },
  { round: 5, kind: "complete feature", verdict: "PASS WITH MINOR FINDINGS", finding: "MIN1, minor: the review schema makes previous required", decision: "ACCEPT", link: comment(217, "6483051924") },
];

// The other high-risk features of the audit's candidate list, from their run records and pull requests.
const features = [
  { issue: 189, pull: 194, anchor: "owner", problem: "Every feature went through the same workflow, whatever it changed", change: "Compute the risk level of a feature from one policy", rounds: "3", findings: "none", verify: "556, 575, 572", run: "four runs; the implementer resumed by hand" },
  { issue: 193, pull: 199, anchor: "repair", problem: "A missed performance target sent the implementer to repair it, with no diagnosed problem", change: "Treat performance budgets as measurements", rounds: "4", findings: "1 major, re-raised once; 1 minor; all fixed", verify: "761, 762, 761", run: "1 h 18 min" },
  { issue: 204, pull: 205, anchor: "short", problem: "The reviewer saw the workflow's own approval records as deleted, though the change never touched them", change: "Show the reviewer no change in paths the fingerprint leaves out", rounds: "1", findings: "none", verify: "909", run: "38 min" },
  { issue: 16, pull: 213, anchor: "short", problem: "An agent could start building while a decision that only the owner can make was still open", change: "Add the feature clarification gate", rounds: "1", findings: "none", verify: "849", run: "26 min" },
];

// The principal source files each pull request changed (git show --stat of its merge commit).
const changed: Record<number, string[]> = {
  194: ["scripts/lib/risk.sh", "scripts/check-risk.sh", "scripts/finish-feature.sh", "scripts/publish-feature.sh", "tests/risk-test.sh"],
  199: ["scripts/verify.sh", "scripts/lib/verification.sh", "scripts/run-feature.sh", "tests/verify-test.sh"],
  205: ["scripts/review-feature.sh", ".agents/prompts/reviewer.md", "tests/review-feature-test.sh"],
  213: ["scripts/run-feature.sh", ".agents/prompts/implementer.md", "scripts/lib/completion.sh", "tests/run-feature-test.sh"],
};

// The groups of the page and their parts, for the contents list.
const groups = [
  { id: "products", title: "Products", items: [
    { id: "fightanalytics", title: "FightAnalytics, a platform for gyms" },
    { id: "application", title: "Physics by Construction, a physics course" },
  ] },
  { id: "engineering", title: "Engineering case studies", items: [
    { id: "memory", title: "When the reviewer did not know what was decided" },
    { id: "story", title: "When new pages left out their sources" },
    { id: "tradeoff", title: "How many review rounds are worth it" },
    { id: "features", title: "Four more problems, four more runs" },
    { id: "owner", title: "When every feature got the same workflow" },
    { id: "repair", title: "When a missed target sent the agent to repair" },
    { id: "short", title: "When one round is enough" },
    { id: "analysis", title: "What 41 recorded runs showed" },
