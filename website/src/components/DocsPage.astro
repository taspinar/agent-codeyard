---
// The frame of Technical Documentation (/docs/) and of its Appendix pages:
// the search and the section navigation (src/lib/docs.ts), "On this page"
// (beside the text above 1100 px, above it below), and the text. On narrow
// screens the navigation is a section picker that names the open topic.
// Code blocks of the text get a copy button.
//
// /docs/ passes its topics (one <section data-topic> each) and their "On this
// page" lists in the slot "toc"; its router (src/pages/docs/index.astro)
// shows one topic at a time. An Appendix page passes its text, its toc, and
// gets previous and next links.
import Base from "../layouts/Base.astro";
import PageHead from "./PageHead.astro";
import DocsSearch from "./DocsSearch.astro";
import { href } from "../lib/links";
import { appendix, first, sections, topics } from "../lib/docs";

export type Heading = { slug: string; text: string; children?: Heading[] };
interface Props {
  title: string;
  description: string;
  /** The Appendix page this is, by its path; none on /docs/. */
  page?: string;
  toc?: Heading[];
  class?: string;
}
const { title, description, page, toc = [], class: kind } = Astro.props;

// On /docs/ a topic is a place on the page; elsewhere a link to it.
const link = (id: string) => (page ? href(`docs/#${id}`) : `#${id}`);
const position = appendix.findIndex((item) => item.path === page);
const previous = position === 0 ? { href: link(topics.at(-1)!.id), title: topics.at(-1)!.title } : appendix[position - 1] && { href: href(appendix[position - 1].path), title: appendix[position - 1].title };
const next = appendix[position + 1] && { href: href(appendix[position + 1].path), title: appendix[position + 1].title };
const picked = page ? appendix[position].title : first.title;
---
<Base title={title} description={description}>
  <PageHead title={title} lede={page ? description : undefined}><slot name="head" /></PageHead>
  <div class="wrap docs-layout">
    <aside class="docs-sidebar">
      {!page && <a id="find-a-command-or-setting"></a>}
      <DocsSearch />
      <details class="docs-disclosure docs-picker">
        <summary>Section: <span data-picked>{picked}</span></summary>
        <nav aria-label="Documentation">
          <ul class="docs-sections">
            {sections.map((section) => (
              <li data-section={section.id} data-open={!page && section.id === first.id ? "" : undefined}>
                <a href={link(section.id)} aria-current={!page && section.id === first.id ? "page" : undefined}>{section.label}</a>
                {section.topics.length > 1 && <ul>{section.topics.slice(1).map((topic) => <li><a href={link(topic.id)}>{topic.title}</a></li>)}</ul>}
              </li>
            ))}
          </ul>
          <p class="nav-group">Appendix</p>
          <ul>{appendix.map((item) => <li><a href={href(item.path)} aria-current={item.path === page ? "page" : undefined}>{item.title}</a></li>)}</ul>
        </nav>
      </details>
    </aside>
    <details class="docs-disclosure docs-toc">
      <summary>On this page</summary>
      <nav aria-label="On this page">
        <slot name="toc">
          <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a>
            {h.children?.length ? <ul>{h.children.map((c) => <li><a href={`#${c.slug}`}>{c.text}</a></li>)}</ul> : null}</li>)}</ul>
        </slot>
      </nav>
    </details>
    <div class="docs-body">
      {page ? <>
        <article data-search><div class:list={["prose", kind]}><slot /></div></article>
        <nav class="docs-pagination" aria-label="Previous and next pages">
          {previous && <a rel="prev" href={previous.href}>Previous: {previous.title}</a>}
          {next && <a rel="next" href={next.href}>Next: {next.title}</a>}
        </nav>
      </> : <article data-search class="docs-topics"><slot /></article>}
    </div>
  </div>
</Base>

<script>
  const narrow = matchMedia("(max-width: 760px)");
  const disclosures = document.querySelectorAll<HTMLDetailsElement>(".docs-disclosure");
  const adapt = () => disclosures.forEach(element => { element.open = !narrow.matches; });
  adapt();
  narrow.addEventListener("change", adapt);

  // A copy button on every code block; it says in its label what it did.
  document.querySelectorAll<HTMLPreElement>(".docs-body pre.astro-code").forEach(pre => {
    const block = document.createElement("div");
    block.className = "code-block";
    pre.replaceWith(block);
    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy the code");
    const status = document.createElement("span");
    status.className = "sr";
    status.setAttribute("role", "status");
    block.append(pre, button, status);
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ""));
        button.textContent = "Copied";
        status.textContent = "Copied to the clipboard.";
      } catch {
        button.textContent = "Copy";
        status.textContent = "Copying failed: select the code and copy it.";
      }
      setTimeout(() => { button.textContent = "Copy"; status.textContent = ""; }, 2000);
    });
  });
</script>
