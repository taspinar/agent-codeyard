---
// The home page, built from the approved design (design/DESIGN.md). Value
// first (#270): the hero, what changes with Codeyard, and who it is for; then
// the route of one feature and the technical proof as a short layer that
// links to Features and Examples, where the detail lives. The facts follow the
// scripts and policies; every example links to its Issue and pull request.
// The risk and profile switches of the route map are the one island; without
// script the map shows medium risk under the standard profile, and the words
// list carries the same route as text.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import DiagramFrame from "../components/DiagramFrame.astro";
import Table from "../components/Table.astro";
import { site } from "../../site.config";
import { href, issue, pull, repoFile } from "../lib/links";

const [first, second] = site.tagline.split(/(?<=\.) /);
const templateName = site.repository.replace(/^https:\/\/github\.com\//, "");

// Recent features of this repository: run records and the published reviews.
const runs = [
  { issue: 217, change: "Give every later review round the earlier decisions", implementer: "claude opus", rounds: "5: two majors fixed, one minor accepted", verify: 1046, pull: 222 },
  { issue: 193, change: "Treat performance budgets as measurements", implementer: "claude fable", rounds: "4: a major re-raised as unresolved, then fixed", verify: 761, pull: 199 },
  { issue: 189, change: "Compute the risk level from one policy", implementer: "claude fable", rounds: "3, after a defect the owner found", verify: 572, pull: 194 },
  { issue: 16, change: "Stop for questions before implementing", implementer: "claude opus", rounds: "1, no findings", verify: 849, pull: 213 },
  { issue: 157, change: "Detect workflow complexity creep", implementer: "claude fable", rounds: "13 over two attempts, a finding open at the end of each" },
];

// Without and with Codeyard, row by row; each "with" names what the scripts do.
const compare = [
  { topic: "Unclear requests", without: "The agent guesses what you meant, and the guess is then reviewed as if it were the requirement.", with: "Requirements and a plan are agreed with you first. An agent that meets an open decision stops with its questions, and you answer." },
  { topic: "Review", without: "The agent that wrote the code checks it, or nobody does.", with: "An agent of another provider reviews the change, and it can only read. As shipped, Claude writes, Codex reviews, and every change is reviewed. A project can change that in its risk policy, the settings file that says how much checking each kind of change gets: the profile, a one-line choice of how much ceremony the project wants, set to profile: light, or the setting low: review: none, lets a low-risk change skip the review, and only those do. The commit and the pull request then record that it was not reviewed, and the merge needs your approval." },
  { topic: "Is it finished?", without: "A session that ends looks like finished work.", with: "For each acceptance criterion, the condition the change must meet, the agent records whether it is met and what shows it. The tests ran on exactly the code that is committed, and that the reviewer read when the change was reviewed." },
  { topic: "Process", without: "A typo and a change to a security check get the same treatment.", with: "Each change gets a risk level from what it touches. High risk gets the stronger model and keeps every control." },
  { topic: "Merge", without: "You find out afterwards what the agent changed and whether it touched something sensitive.", with: "No script merges. You merge every pull request, and changes to protected files wait for your approval." },
  { topic: "Afterwards", without: "What happened in a session is gone with the terminal.", with: "Every run leaves a record: the review rounds and findings, if it was reviewed, what was decided, the checks, and why a run stopped." },
];
---
<Base description={site.description}>
  <div class="hero wrap">
    <div class="hero-grid">
      <h1>{first} <em>{second}</em></h1>
      <div class="hero-side">
        <p class="lede">Turn AI-generated code into tested pull requests, changes proposed on GitHub that you read and merge, each independently reviewed unless you let low-risk changes skip the review.</p>
        <p class="hero-copy">Agent Codeyard is an open-source workflow for developers using Claude Code and Codex: it helps you plan features, run coding agents, verify their work and catch problems before merging. Your agents do the coding, Codeyard manages the process, you stay in control.</p>
        <div class="actions">
          <a class="btn" href={href("workflow/")}>Explore the workflow</a>
          <a href={href("docs/")}>Get started</a>
        </div>
      </div>
    </div>
    <p class="facts-line"><span>Open source</span><span>Runs locally</span><span>GitHub-based</span><span>No automatic merging</span></p>
  </div>

  <Section id="change" title="What changes">
    <Fragment slot="note">Each line on the right is a script or a policy of the template. <a href={href("features/")}>Features</a> shows how.</Fragment>
    <div class="compare" role="group" aria-label="Without and with Codeyard">
      <div class="col"><h3>Without Codeyard</h3><dl>
        {compare.map((row) => <><dt>{row.topic}</dt><dd>{row.without}</dd></>)}
      </dl></div>
      <div class="col"><h3>With Codeyard</h3><dl>
        {compare.map((row) => <><dt>{row.topic}</dt><dd>{row.with}</dd></>)}
      </dl></div>
    </div>
    <p class="needs">Codeyard enforces its rules in its own scripts; GitHub enforces them only with the repository settings described in the docs, and an agent working under your GitHub account has your rights there until a separate agent identity is built (<a href={issue(99)}>#99</a>).</p>
  </Section>

  <Section id="who" title="Who it is for">
    <Fragment slot="note">What you need: the <a href={href("docs/")}>getting-started guide</a>.</Fragment>
    <p class="lede">Developers and teams who already use command-line coding agents and GitHub, and want structure around them. It is not a no-code tool: you work in a terminal and a Git repository.</p>
    <p>Codeyard is not an application and not an agent. It is a set of shell scripts, agent instructions and policy files that live in your repository. A new project starts from the template with <code>gh repo create --template</code>; there is no installer and no platform to host. Bringing an existing repository into the workflow is <a href={issue(170)}>planned in #170</a> and not built yet.</p>
    <div class="ledger" role="group" aria-label="Who does what">
      <div><h3>The agents</h3><ul><li>Write the code and the tests</li><li>Review a change, read-only</li><li>Propose the triage: fix, defer or accept each finding</li></ul></div>
      <div><h3>Codeyard</h3><ul><li>Computes the risk level of each change</li><li>Picks the agent and model for the level</li><li>Refuses a review by the implementer's own provider</li><li>Commits only verified, complete work, reviewed unless your settings let a low-risk change skip the review</li></ul></div>
      <div><h3>You</h3><ul><li>Approve the plan</li><li>Answer what the agents cannot decide</li><li>Approve protected changes</li><li>Merge</li></ul></div>
    </div>
  </Section>

  <section class="route-sec" aria-labelledby="route-title">
    <div class="wrap" data-risk="medium" data-profile="standard" id="lifecycle">
      <DiagramFrame id="route" title="The route of one feature">
        <form slot="controls" class="switches" aria-label="Show the route for">
          <fieldset class="switch">
            <legend>risk</legend>
            <label><input type="radio" name="risk" value="low"><span>low</span></label>
            <label><input type="radio" name="risk" value="medium" checked><span>medium</span></label>
            <label><input type="radio" name="risk" value="high"><span>high</span></label>
          </fieldset>
          <fieldset class="switch">
            <legend>profile, how much ceremony</legend>
            <label><input type="radio" name="profile" value="standard" checked><span>standard</span></label>
            <label><input type="radio" name="profile" value="light"><span>light</span></label>
          </fieldset>
        </form>

        <svg class="map" viewBox="-30 0 1260 262" role="img" aria-labelledby="map-title" aria-describedby="route-words">
          <title id="map-title">The route of one feature from Issue to merge, with its loops, a clarification stop and a review bypass for a low-risk change under the light profile or the setting low: review: none.</title>
          <!-- loops above the line -->
          <path class="branch" d="M362 124 L326 88 H254 L218 124"/>
          <text class="note" x="290" y="78" text-anchor="middle">checks fail: repair</text>
          <path class="branch" d="M672 124 L630 82 H420 L378 124"/>
          <text class="note" x="525" y="72" text-anchor="middle">findings fixed: checks, review again</text>
          <path class="branch" d="M204 124 L172 92"/>
          <rect class="gate-o" x="157" y="77" width="15" height="15" transform="rotate(45 164.5 84.5)"/>
          <text class="note" x="148" y="60" text-anchor="middle">unclear: you answer</text>
          <!-- the route -->
          <path class="trunk" d="M50 130 H450"/>
          <path class="trunk reviewed" d="M450 130 H755"/>
          <path class="trunk" d="M755 130 H1130"/>
          <!-- review bypass: low risk under the light profile -->
          <path class="branch bypass" d="M450 136 V200 L472 222 H733 L755 200 V136"/>
          <text class="note bypass-note" x="602" y="250" text-anchor="middle">low risk, light profile: no review, and the merge needs your approval</text>
          <!-- stations -->
          <g><circle class="dot" cx="50" cy="130" r="10"/><text class="st" x="50" y="167" text-anchor="middle">Issue</text><text class="sub" x="50" y="186" text-anchor="middle">from the roadmap</text></g>
          <g><circle class="dot" cx="210" cy="130" r="10"/><text class="st" x="210" y="167" text-anchor="middle">Implement</text><text class="sub k" x="210" y="186" text-anchor="middle" data-k="impl">claude opus</text></g>
          <g><circle class="dot" cx="370" cy="130" r="10"/><text class="st" x="370" y="167" text-anchor="middle">Checks</text><text class="sub k" x="370" y="186" text-anchor="middle">verify.sh</text></g>
          <g class="r-dim"><circle class="dot" cx="530" cy="130" r="10"/><text class="st" x="530" y="167" text-anchor="middle">Review</text><text class="sub k" x="530" y="186" text-anchor="middle" data-k="review">codex, read-only</text></g>
          <g class="r-dim"><circle class="dot" cx="680" cy="130" r="10"/><text class="st" x="680" y="167" text-anchor="middle">Findings</text><text class="sub" x="680" y="186" text-anchor="middle" data-k="triage">each finding decided</text></g>
          <g><circle class="dot" cx="830" cy="130" r="10"/><text class="st" x="830" y="167" text-anchor="middle">Commit</text><text class="sub" x="830" y="186" text-anchor="middle">only when complete</text></g>
          <g><circle class="dot" cx="970" cy="130" r="10"/><text class="st" x="970" y="167" text-anchor="middle">Pull request</text><text class="sub" x="970" y="186" text-anchor="middle">CI checks</text></g>
          <g><rect class="gate" x="1120" y="120" width="20" height="20" transform="rotate(45 1130 130)"/><text class="st" x="1130" y="167" text-anchor="middle">Merge</text><text class="sub" x="1130" y="186" text-anchor="middle">by you</text><text class="sub bypass-note" x="1130" y="204" text-anchor="middle">approval required</text></g>
        </svg>
        <ul slot="legend" class="legend" aria-hidden="true">
          <li><svg width="28" height="8"><path d="M2 4 H26" stroke="var(--line)" stroke-width="6" stroke-linecap="round"/></svg>the route</li>
          <li><svg width="28" height="8"><path d="M2 4 H26" stroke="var(--rule-strong)" stroke-width="3" stroke-dasharray="6 5"/></svg>only when needed</li>
          <li><svg width="14" height="14"><circle cx="7" cy="7" r="5" fill="none" stroke="var(--ink)" stroke-width="2.5"/></svg>a step that a script or an agent runs</li>
          <li><svg width="14" height="14"><rect x="3" y="3" width="8" height="8" transform="rotate(45 7 7)" fill="var(--ink)"/></svg>you decide</li>
          <li><svg width="14" height="14"><rect x="3" y="3" width="8" height="8" transform="rotate(45 7 7)" fill="none" stroke="var(--ink)" stroke-width="2"/></svg>you answer, only when asked</li>
        </ul>

        <ol slot="words" class="words" id="route-words">
          <li><b>Issue</b><small>from the roadmap</small></li>
          <li><b>Implement</b><small class="k" data-k="impl">claude opus</small><p class="cond">If a decision that matters is unclear, the implementer stops with its questions and you answer.</p></li>
          <li><b>Checks</b><small class="k">verify.sh</small><p class="cond">If a check fails, the implementer repairs it.</p></li>
          <li class="r-word"><b>Review</b><small class="k" data-k="review">codex, read-only</small></li>
          <li class="r-word"><b>Findings</b><small data-k="triage">each finding decided</small><p class="cond">Fixes are checked and reviewed again.</p></li>
          <li><b>Commit</b><small>only when complete</small></li>
          <li><b>Pull request</b><small>CI checks</small></li>
          <li class="you"><b>Merge</b><small data-k="merge">by you</small></li>
        </ol>
        <span slot="caption" data-k="caption"><strong>Medium risk.</strong> Claude implements and Codex reviews, so the reviewer always comes from another provider, and the merge stays with you.</span>
      </DiagramFrame>
      <p class="needs">The implementer is the agent that writes the change; the reviewer reads it. The checks are the tests and other checks of <code>verify.sh</code>, and the triage decides what happens to each review finding: fix it now, defer it to a new Issue, or accept it with a reason. A commit is made only when the implementer records every criterion as met, the checks passed, and the review is done where one is required. <a href={href("workflow/")}>Every step of the route</a>.</p>
    </div>
  </section>

  <Section id="how" title="Plan once, then one line per feature">
    <Fragment slot="note">Every step on the <a href={href("workflow/")}>workflow page</a>.</Fragment>
    <figure class="plain">
      <svg class="lines" viewBox="-20 0 1140 200" role="img" aria-labelledby="lines-t" aria-describedby="lines-words">
        <title id="lines-t">Planning runs once: idea, requirements, plan, plan review, your approval. From the approved plan, each feature runs its own line from Issue to merge.</title>
        <path class="l1" d="M40 50 H700"/>
        <path class="l2" d="M700 50 L780 130 H1080"/>
        <circle class="dot" cx="40" cy="50" r="9"/><text class="st" x="40" y="26" text-anchor="middle">Idea</text>
        <circle class="dot" cx="210" cy="50" r="9"/><text class="st" x="210" y="26" text-anchor="middle">Requirements</text><text class="sub" x="210" y="80" text-anchor="middle">an agent asks you</text>
        <circle class="dot" cx="380" cy="50" r="9"/><text class="st" x="380" y="26" text-anchor="middle">Plan</text><text class="sub" x="380" y="80" text-anchor="middle">architecture, roadmap</text>
        <circle class="dot" cx="550" cy="50" r="9"/><text class="st" x="550" y="26" text-anchor="middle">Plan review</text><text class="sub" x="550" y="80" text-anchor="middle">another provider</text>
        <rect class="gate" x="690" y="40" width="20" height="20" transform="rotate(45 700 50)"/><text class="st" x="700" y="26" text-anchor="middle">You approve</text>
        <circle class="dot" cx="800" cy="130" r="9"/><text class="st" x="800" y="166" text-anchor="middle">Feature Issue</text>
        <circle class="dot" cx="940" cy="130" r="9"/><text class="st" x="940" y="166" text-anchor="middle">Run</text><text class="sub" x="940" y="186" text-anchor="middle">build, check, review if required</text>
        <rect class="gate" x="1070" y="120" width="20" height="20" transform="rotate(45 1080 130)"/><text class="st" x="1080" y="166" text-anchor="middle">Merge</text>
      </svg>
      <ol class="words lines-words" id="lines-words">
        <li><b>Idea</b></li>
        <li><b>Requirements</b><small>an agent asks you</small></li>
        <li><b>Plan</b><small>architecture, roadmap</small></li>
        <li><b>Plan review</b><small>another provider</small></li>
        <li class="you"><b>You approve</b><p class="cond">Then, per feature:</p></li>
        <li><b>Feature Issue</b></li>
        <li><b>Run</b><small>build, check, review if required</small></li>
        <li class="you"><b>Merge</b><small>by you</small></li>
      </ol>
    </figure>
    <p>The Project Grill is an agent that questions you about goals, users and scope until the requirements are written down. A planning change, a new requirement or a changed roadmap, goes back through the plan review and your approval before features are built on it. Each feature, one GitHub Issue, then runs step by step, with you approving the triage, or in one unattended command, <code>run-feature.sh</code>, which runs every step without waiting for you and stops whenever it needs you.</p>
  </Section>

  <Section id="risk" title="More risk, more evidence">
    <Fragment slot="note">The levels, the profiles and what each changes: <a href={href("features/#risk")}>Risk-proportionate workflow</a>, the checking scaled to what a change risks.</Fragment>
    <p>Each change gets a risk level, low, medium or high, computed from the files it touches. An agent cannot lower it; you can raise it. The level picks the model that writes the change and what the review rounds require, and high risk always keeps every control. As shipped there is no low level, so every change is reviewed.</p>
    <p>A project can choose less ceremony with one line, <code>profile: light</code>: documentation and process files are then low risk and skip the review, as a low class of its own does with <code>low: review: none</code>. The commit says so, and the merge then needs your approval. Under every setting each commit needs the full checks, and only you merge.</p>
  </Section>

  <Section id="review" title="The agent that writes the code does not judge it">
    <Fragment slot="note">Enforced by <a href={repoFile("scripts/review-feature.sh")}><code>review-feature.sh</code></a>.</Fragment>
    <p>When a change is reviewed, the reviewer is always an agent of another provider than the implementer, Codex for Claude's work as shipped: the script refuses a reviewer of the same provider. The reviewer can only read.</p>
    <div class="handoff">
      <div><h3>Implementer</h3><ul><li>Reads the Issue, your comments, the requirements and the architecture</li><li>Asks before it builds when a decision is unclear</li><li>Writes the code and the tests</li><li>Runs the checks and records evidence for each criterion</li></ul></div>
      <p class="handoff-mid" aria-hidden="true"><span>the content it checked</span></p>
      <div><h3>Reviewer</h3><ul><li>Reads the same Issue, the requirements and the diff</li><li>Reviews exactly the content the checks passed for</li><li>Reports findings by severity and the impact on the architecture</li><li>Cannot change a file</li></ul></div>
    </div>
  </Section>

  <Section id="control" title="Automation stops where ownership begins">
    <Fragment slot="note">Every gate on the <a href={href("workflow/")}>workflow page</a>.</Fragment>
    <p>You are not asked everywhere. You decide at fixed points, and the run stops for you when it cannot go on safely.</p>
    <ol class="gates">
      <li class="you"><b>Approve the requirements</b><span>Project Grill drafts them from your description; nothing is planned before you approve.</span></li>
      <li class="you"><b>Approve the plan</b><span>Architecture and roadmap, after a review by another provider; you merge the planning pull request.</span></li>
      <li class="ask"><b>Answer when asked</b><span>An implementer that finds a decision unclear stops with its questions instead of guessing.</span></li>
      <li class="you"><b>Decide on the findings</b><span>When a change is reviewed: step by step you approve the triage; unattended, the triage is recorded for you to read.</span></li>
      <li class="you"><b>Merge</b><span>Every pull request; a protected change, a change that skipped the review, or a review that sees major impact on the architecture asks for your approval by name.</span></li>
    </ol>
  </Section>

  <Section id="trace" title="Every claim has a record">
    <Fragment slot="note">Followed in detail: <a href={href("examples/#e2e")}>#217, end to end</a>. How the agent's evidence for each acceptance criterion is checked: <a href={href("features/#evidence")}>Evidence per acceptance criterion</a>.</Fragment>
    <p>Each step of a feature leaves a record anyone can open: the Issue with its acceptance criteria, the implementer's completion record, which says criterion by criterion what is met and what shows it, the published review findings and decisions when the change was reviewed, the verification of exactly the committed content, and the pull request that carries all of it. These are the records of one real feature.</p>
    <ol class="trail" aria-label="The records of feature 217">
      <li><b>Finding</b><a href={href("examples/#analysis")}>28 October</a><span>The analysis of 41 runs: a fixed finding came back as unresolved in five runs.</span></li>
      <li><b>Issue</b><a href={issue(217)}>#217</a><span>Six acceptance criteria.</span></li>
      <li><b>Completion record</b><span>The implementer's claim, criterion by criterion, with evidence.</span></li>
      <li><b>Review findings</b><a href={issue(217)}>on #217</a><span>Five rounds, each review and triage published.</span></li>
      <li><b>Verification</b><span>Recorded for exactly the content that was reviewed.</span></li>
      <li><b>Pull request</b><a href={pull(222)}>#222</a><span>Merged by the owner.</span></li>
    </ol>
  </Section>

  <Section id="runs" title="Codeyard builds Codeyard">
    <Fragment slot="note">Recent changes to this repository, made with its own workflow. <a href={href("examples/")}>Followed in detail</a>.</Fragment>
    <Table>
      <caption>From the run records and the reviews published on each Issue. Verification is one full run of <code>verify.sh</code> on the maintainer's server.</caption>
      <thead><tr><th scope="col">issue</th><th scope="col">change</th><th scope="col">risk</th><th scope="col">implementer</th><th scope="col">review rounds</th><th scope="col" class="num">verify</th><th scope="col">result</th></tr></thead>
      <tbody>
        {runs.map((run) => (
          <tr>
            <th scope="row"><a href={issue(run.issue)}>#{run.issue}</a></th>
            <td data-col="change">{run.change}</td>
            <td data-col="risk"><span class="lvl high">high</span></td>
            <td data-col="implementer" class="k">{run.implementer}</td>
            <td data-col="review rounds">{run.rounds}</td>
            {run.verify ? <td data-col="verify" class="num">{run.verify} s</td> : <td data-col="verify" class="num off">–</td>}
            {run.pull ? <td data-col="result"><a href={pull(run.pull)}>PR #{run.pull}</a></td> : <td data-col="result" class="off">parked</td>}
          </tr>
        ))}
      </tbody>
    </Table>
  </Section>

  <Section id="learn" title="Learn from your runs">
    <Fragment slot="note">How it works: <a href={href("features/#learn")}>Learning from your runs</a>. What it found here: <a href={href("examples/#analysis")}>the analysis of 28 October 2026</a>.</Fragment>
    <p>Every run records its review rounds and findings, if it was reviewed, what was decided, the checks that failed, why it stopped, and the time and tokens of each step. After a number of features you ask a read-only analyst, an agent that changes nothing, what keeps costing rounds, and it proposes what to change. Nothing changes until you decide.</p>
    <p>Codeyard ran it on its own 41 runs of 19 features. Five of its proposals became Issues, and all five were merged.</p>
  </Section>

  <Section id="start" title="Start a project">
    <Fragment slot="note">The full <a href={href("docs/")}>getting-started guide</a>.</Fragment>
    <pre role="region" tabindex="0" class="term" aria-label="Terminal commands"><span class="c"># a new repository from the template</span>
<span class="p">$ </span>gh repo create my-project --template {templateName} --private --clone
<span class="p">$ </span>cd my-project
<span class="p">$ </span>./scripts/doctor.sh
<span class="c"># plan once: requirements, architecture, roadmap; you approve</span>
<span class="p">$ </span>./scripts/start-planning.sh --description idea.md
<span class="c"># then each feature, from Issue to pull request</span>
<span class="p">$ </span>./scripts/create-feature-issue.sh F01
<span class="p">$ </span>./scripts/run-feature.sh 1</pre>
    <p class="needs">There is no installer: the template is the starting point. You need Git, the GitHub CLI, <code>jq</code>, Claude Code and Codex: as shipped, Claude implements and Codex reviews, and a review by the implementer's own provider is refused. <code>doctor.sh</code> checks all of it, including the Codex sandbox and your Git identity.</p>
  </Section>

  <section id="cta" aria-labelledby="cta-h">
    <div class="wrap cta">
      <h2 id="cta-h">Build with agents. Ship with evidence.</h2>
      <div class="actions">
        <a class="btn" href={href("workflow/")}>Explore the workflow</a>
        <a href={href("docs/")}>Get started</a>
      </div>
      <p>Open source, MIT licence. Runs on your machine with Claude Code and Codex.</p>
    </div>
  </section>
</Base>

<script>
  // The route of one feature: redraws the hero map for a risk level and a
  // workflow profile. CSS redraws the route from data-risk and data-profile;
  // this swaps the labels, the words list and the caption.
  const root = document.getElementById("lifecycle");
  const form = root?.querySelector<HTMLFormElement>(".switches");

  function labels(level: string, profile: string): Record<string, string> {
    const bypass = level === "low" && profile === "light";
    return {
      impl: level === "high" ? "claude fable" : "claude opus",
      review: bypass ? "skipped" : "codex, read-only",
      triage: bypass ? "none" : profile === "light" && level !== "high" ? "minor ones may wait" : "each finding decided",
      merge: "by you",
      caption: bypass
        ? "<strong>Low risk, light profile.</strong> Documentation and process files skip the review. The commit records that it was not reviewed, and the merge waits for your approval."
        : level === "high"
          ? "<strong>High risk.</strong> The stronger model implements, every finding is decided before the commit, and no profile can remove the review or lower the level."
          : level === "low"
            ? "<strong>Low risk, standard profile.</strong> Reviewed by another provider, unless the project sets <code>low: review: none</code> or the light profile: then a low-risk change skips the review, the commit records it, and the merge needs your approval. As shipped there is no low class; a project adds one in risk.conf."
            : profile === "light"
              ? "<strong>Medium risk, light profile.</strong> Reviewed; minor findings and suggestions can be accepted or deferred without another fix round."
              : "<strong>Medium risk.</strong> Claude implements and Codex reviews, so the reviewer always comes from another provider, and the merge stays with you.",
    };
  }

  if (root && form) {
    form.addEventListener("change", () => {
      const level = (form.elements.namedItem("risk") as RadioNodeList).value;
      const profile = (form.elements.namedItem("profile") as RadioNodeList).value;
      root.dataset.risk = level;
      root.dataset.profile = profile;
      const text = labels(level, profile);
      // The labels are HTML and SVG elements alike.
      root.querySelectorAll("[data-k]").forEach((element) => {
        const key = element.getAttribute("data-k") ?? "";
        if (key === "caption") element.innerHTML = text.caption;
        else element.textContent = text[key];
      });
      root.querySelectorAll<HTMLElement>(".r-word").forEach((item) => {
        item.hidden = level === "low" && profile === "light";
      });
    });
  }
</script>
