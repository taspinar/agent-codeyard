---
// A section of a page: the heading column (h2 and a short note naming the
// source) beside the body column. The heading column is sticky while the grid
// has two columns. A section inside a group of a page takes an h3.
interface Props { id: string; title: string; level?: 2 | 3 }
const { id, title, level = 2 } = Astro.props;
const Heading = level === 3 ? "h3" : "h2";
---
<section id={id} aria-labelledby={`${id}-h`}>
  <div class="wrap sec">
    <header><Heading id={`${id}-h`}>{title}</Heading>{Astro.slots.has("note") && <p><slot name="note" /></p>}</header>
    <div class="body"><slot /></div>
  </div>
</section>
